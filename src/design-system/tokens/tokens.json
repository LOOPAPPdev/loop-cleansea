  "semantic": {
    "color-bg": {
      "$type": "color",
      "$value": "{loop-white}"
    },
    "color-surface": {
      "$type": "color",
      "$value": "{loop-slate-100}"
    },
    "color-surface-sunken": {
      "$type": "color",
      "$value": "{loop-slate-200}"
    },
    "color-surface-raised": {
      "$type": "color",
      "$value": "{loop-white}"
    },
    "color-text": {
      "$type": "color",
      "$value": "{loop-slate-900}"
    },
    "color-text-muted": {
      "$type": "color",
      "$value": "{loop-slate-600}"
    },
    "color-on-primary": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "theme": {
          "dark": "#0f1215"
        }
      }
    },
    "color-link": {
      "$type": "color",
      "$value": "{loop-blue}"
    },
    "color-divider": {
      "$type": "color",
      "$value": "color-mix(in srgb, {loop-slate-900} 10%, transparent)"
    },
    "color-border-strong": {
      "$type": "color",
      "$value": "{loop-slate-500}"
    },
    "color-focus": {
      "$type": "color",
      "$value": "{loop-blue}"
    },
    "color-scrim": {
      "$type": "color",
      "$value": "rgb(17 20 24 / 0.4)"
    },
    "action-primary": {
      "$type": "color",
      "$value": "{loop-slate-900}"
    },
    "action-primary-hover": {
      "$type": "color",
      "$value": "#2a3038",
      "$extensions": {
        "theme": {
          "dark": "#d5dce2"
        }
      }
    }
  },
  "typography": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "{font-inter}, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "text-micro": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "text-caption": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "text-body": {
      "$type": "dimension",
      "$value": "1.0625rem"
    },
    "text-lead": {
      "$type": "dimension",
      "$value": "clamp(1.125rem, 1.6vw, 1.3125rem)"
    },
    "text-card": {
      "$type": "dimension",
      "$value": "1.3125rem"
    },
    "text-h3": {
      "$type": "dimension",
      "$value": "clamp(1.5rem, 2.6vw, 2.25rem)"
    },
    "text-h2": {
      "$type": "dimension",
      "$value": "clamp(1.75rem, 3.4vw, 2.5rem)"
    },
    "text-display": {
      "$type": "dimension",
      "$value": "clamp(2.5rem, 6vw, 4.75rem)"
    },
    "leading-tight": {
      "$type": "number",
      "$value": "1.05"
    },
    "leading-snug": {
      "$type": "number",
      "$value": "1.25"
    },
    "leading-body": {
      "$type": "number",
      "$value": "1.5"
    },
    "tracking-display": {
      "$type": "dimension",
      "$value": "-0.035em"
    },
    "tracking-heading": {
      "$type": "dimension",
      "$value": "-0.02em"
    }
  },
  "spacing": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "space-10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "space-12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "space-16": {
      "$type": "dimension",
      "$value": "64px"
    },
    "space-section": {
      "$type": "dimension",
      "$value": "clamp(56px, 8vw, 112px)"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "max(16px, 4vw)"
    },
    "container": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "measure": {
      "$type": "dimension",
      "$value": "720px"
    }
  },
  "shape": {
    "radius-sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "radius-card": {
      "$type": "dimension",
      "$value": "16px"
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "shadow-sm": {
      "$type": "shadow",
      "$value": "0 0 0 1px {color-divider}"
    },
    "shadow-md": {
      "$type": "shadow",
      "$value": "0 12px 32px rgb(17 20 24 / 0.12)"
    }
  },
  "interaction": {
    "target-min": {
      "$type": "dimension",
      "$value": "44px"
    },
    "duration-fast": {
      "$type": "duration",
      "$value": "0.16s"
    },
    "duration-base": {
      "$type": "duration",
      "$value": "0.24s"
    },
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "header-height": {
      "$type": "dimension",
      "$value": "72px"
    }
  }
}
